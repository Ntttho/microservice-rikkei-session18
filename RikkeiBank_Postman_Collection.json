              "raw": "{\n  \"email\": \"newuser@rikkeibank.com\",\n  \"password\": \"NewUser@123456\",\n  \"fullName\": \"Le Van C\",\n  \"phoneNumber\": \"0944444444\",\n  \"roles\": [\"CUSTOMER\"]\n}"
